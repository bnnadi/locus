# Locus environment template.
#
# Copy to .env at the repo root (scripts/setup.sh does this for you) and fill
# in real values. .env is gitignored; never commit filled-in credentials.
# On Railway these are set in the service's Variables tab, not from a file.
#
# Placeholders are intentionally empty rather than fake-but-plausible, so a
# missing value fails loudly instead of connecting somewhere unexpected.

# --- Image versions -------------------------------------------------------
# Pinned here so docker-compose.yml has no version literals in it. Move these
# to exact patch versions before running anything you care about; a floating
# minor tag means a rebuild can change the stack with nothing in the diff.
POSTGRES_VERSION=16-alpine
NEO4J_VERSION=5-community
HERMES_VERSION=v2026.8.16

# Not read by compose. This mirrors the ARG default in
# services/hermes/Dockerfile, which installs the opencode CLI that every
# shadow-team profile shells out to. Documented here so the version is
# visible next to the others rather than buried in a build file; bump both
# together or tests/unit/test_hermes_opencode_pin.sh fails.
OPENCODE_VERSION=1.18.32

# --- Deploy ---------------------------------------------------------------
# railway | compose. scripts/deploy.sh refuses to guess.
LOCUS_DEPLOY_TARGET=compose

# --- Postgres -------------------------------------------------------------
# One instance, one role and database per consuming service. POSTGRES_USER is
# the superuser used only for bootstrap and migrations.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Superuser connection, used by scripts/setup.sh to create per-service roles
# and databases. Not used at runtime by any service.
ADMIN_DATABASE_URL=

# Target for scripts/migration.sh --target postgres.
DATABASE_URL=

# --- Neo4j ----------------------------------------------------------------
# Shared with the Knowledge-Graph MCP. See the CodePattern label question in
# docs/deployment/hermes-memory-layer.md before pointing both at one instance.
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_MAX=1G
# Compose: bolt://neo4j:7687 — Railway: bolt://neo4j.railway.internal:7687
NEO4J_URI=bolt://neo4j:7687

# --- n8n ------------------------------------------------------------------
# Password for the n8n Postgres role, created by scripts/setup.sh.
N8N_DB_PASSWORD=
# Encrypts stored credentials. If this is unset, n8n generates a new key
# whenever its data directory is empty and every credential saved under the
# previous key becomes permanently undecryptable. Set it before creating any
# credentials, and treat it as rotate-only-with-migration.
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
# Railway injects PORT and healthchecks it. The n8n image refuses to
# start if PORT and N8N_PORT differ; pin PORT=5678 on the Railway
# service so it matches N8N_PORT and the dashboard target port.
# Compose does not set PORT.
GENERIC_TIMEZONE=UTC
# Base URL used by scripts/deploy.sh for the readiness gate.
N8N_URL=http://127.0.0.1:5678

# --- Ollama ---------------------------------------------------------------
# Space-separated models to pull at boot (commas or a JSON array also work
# after the entrypoint normalizes them). Deliberately NOT named OLLAMA_MODELS:
# Ollama reserves that for the models directory path, so reusing it would
# point the server at a directory named after your models.
# Railway: a JSON array with no spaces is one invalid name and crash-loops.
OLLAMA_PULL_MODELS=
OLLAMA_PORT=8080
# Must agree with OLLAMA_HOST in services/ollama/Dockerfile (currently 8080,
# not the upstream default of 11434).
# Compose: http://ollama:8080 — Railway: http://ollama.railway.internal:8080
OLLAMA_URL=http://ollama:8080

# --- Qdrant ---------------------------------------------------------------
QDRANT_API_KEY=
QDRANT_PORT=6333
# Compose: http://qdrant:6333 — Railway: http://qdrant.railway.internal:6333
QDRANT_URL=http://qdrant:6333

# --- hermes-memory-router -------------------------------------------------
# Inbound bearer secret: every protected route (POST /traces, POST /retrieve,
# GET /trace/{id}/provenance, POST /strategies/{id}/quarantine,
# DELETE /strategies/{id}) requires "Authorization: Bearer <token>".
# GET /health is open. Required — the router refuses to start without this.
HERMES_MEMORY_ROUTER_TOKEN=
# claude | ollama | hermes. Selectable per-request via the body's "backend".
EXTRACTION_BACKEND=claude
# Required when EXTRACTION_BACKEND=claude. POST /traces spends money per
# request, so keep the router off a public domain.
ANTHROPIC_API_KEY=
# Set once Hermes exposes its own extraction endpoint.
HERMES_EXTRACT_ENDPOINT=
# Outbound bearer for HERMES_EXTRACT_ENDPOINT only (not the inbound router token).
HERMES_TOKEN=
# Changing this requires recreating the Qdrant collection: the stored vectors
# have the old model's dimensionality.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HERMES_ROUTER_PORT=8000
# Used by scripts/deploy.sh and scripts/maintenance/smoke_test_hermes_memory.sh
# Compose: http://127.0.0.1:8000
# Railway: http://hermes-memory-router.railway.internal:8000
HERMES_MEMORY_ROUTER_URL=http://127.0.0.1:8000

# --- authentik ------------------------------------------------------------
# OSS IdP (ghcr.io/goauthentik/server:2026.8.2). Pin lives in
# services/authentik/server/Dockerfile and .../worker/Dockerfile.
# Password for the authentik Postgres role, created by scripts/setup.sh.
AUTHENTIK_DB_PASSWORD=
# Cookie/session signing. Rotate only with a planned session invalidation.
# Railway: paste a generated value; setup.sh is not run there.
AUTHENTIK_SECRET_KEY="$(openssl rand -hex 32)"
# First-boot akadmin. Set on both Railway services (server and worker)
# before a public domain. Confirm /if/flow/initial-setup/ is closed.
# Only read on first startup. Do not set AUTHENTIK_BOOTSTRAP_PASSWORD_HASH
# as well — both set is a startup error. Railway does not run setup.sh:
# paste generated hex into the Variables tab, not the $(openssl …)
# generator string.
AUTHENTIK_BOOTSTRAP_PASSWORD="$(openssl rand -hex 24)"
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_TOKEN="$(openssl rand -hex 32)"
AUTHENTIK_PORT=9000
# Host / deploy.sh readiness gate. Compose Uzora uses http://authentik:9000.
AUTHENTIK_URL=http://127.0.0.1:9000
# Full OIDC issuer (must match token iss) and audience. Empty until the
# OIDC app exists — do not make Compose require these or first boot deadlocks.
AUTHENTIK_ISSUER=
AUTHENTIK_AUDIENCE=fXqCJHcHhV3Q3tBkYhfJ7GNW5YpkJlOHimL9pmYj (clientID)
secret=EhNjVjqpkNthlWWXofYh5je24c6Y5J8VSY83RI6TNwjagHcl8Ti8N5tlDkS4vvlqdhAa5Wm2tBQfscwnQbEP9Ee9pJy7F0MGMAhJebOE1f2ES9KeZGOG9IG1lq7yJWqK
# --- uzora ----------------------------------------------------------------
# Token gate. Compose in-network AUTHENTIK_URL is hardcoded to http://authentik:9000.
UZORA_PORT=8100
# Host / deploy.sh readiness gate. Railway: http://uzora.railway.internal:8100
UZORA_URL=http://127.0.0.1:8100

# --- Hermes ---------------------------------------------------------------
# scripts/setup.sh expands $(openssl rand -hex N) in .env and writes the hex
# back so a re-run does not rotate the key. Railway does not run setup.sh:
# paste a generated value into the service Variables tab.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY="$(openssl rand -hex 32)"
# Dashboard is the public surface (9119). A non-loopback bind fails closed
# without a provider; HERMES_DASHBOARD_INSECURE is a no-op. Fill username
# and password before the first public deploy.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET="$(openssl rand -hex 32)"
# Compose: http://127.0.0.1:9119 — Railway: the public domain
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# API stays internal. Compose: http://hermes:8642
# Railway: http://hermes.railway.internal:8642
HERMES_URL=http://127.0.0.1:8642

# --- Hermes shadow team ---------------------------------------------------
# Consumed by the default profile's GitHub MCP server (see
# services/hermes/profiles/default/config.yaml). Hermes reads it from
# /opt/data/.env on the volume, not from this file, since the profiles are
# installed into a running instance rather than baked into the image.
#
# This token is the real security boundary for the agent team, because any
# worker lane can read /opt/data/.env. Scope it accordingly: fine-grained,
# one repository, contents:read + pull_requests:write, NO Workflows
# permission, short expiry. Without Workflows, GitHub rejects any push that
# touches .github/workflows, which is what stops an agent granting itself CI
# execution with your secrets. See services/hermes/SECURITY.md.
GITHUB_PAT=